<FindBugsFilter>
    <!-- For documentation on this file's format,
              see http://git.eclipse.org/c/tcf/org.eclipse.tcf.git/plain/admin/findbugs-exclude.xml

    For a description of the error codes,
    see http://findbugs.sourceforge.net/bugDescriptions.html
    -->

    <!-- placeholder for any exclusions -->

    <!-- Exclude errors from code-gen for generated fields of type "Date"  -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2,EI_EXPOSE_REP"/>
        <Package name="com.oracle.pic.networking.lvv.service.model" />
    </Match>

    <!--  AuthHelper constructor takes in a mutable AuthorizationClient as a parameter.
    There is no .clone() or .toBuilder() methods offered by Identity at the moment, which
    complicates instantiating a new AuthorizationClient.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="com.oracle.pic.networking.lvv.service.auth.AuthHelper" />
        <Method name="&lt;init&gt;"/>
    </Match>

    <!--  LvvServiceApiModule constructor takes in a mutable LvvServiceApiConfiguration as a parameter.
    Some LvvServiceApiConfiguration properties such as MetricsConfiguration do not have a .toBuilder()
    or .clone() method, which complicates instantiating a new LvvServiceApiConfiguration.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="com.oracle.pic.networking.lvv.service.config.LvvServiceApiModule" />
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Class name="com.oracle.pic.networking.lvv.service.model.LvvReadAllProjectsResource"/>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
    </Match>
</FindBugsFilter>
