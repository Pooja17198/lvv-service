  <build>
    <plugins>

      <plugin>
        <!-- Copy the api.yaml file to the build output directory -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <ignoredDependencies>
            <ignoredDependency>commons-lang:commons-lang</ignoredDependency>
          </ignoredDependencies>
        </configuration>
        <executions>
          <execution>
            <id>unpack</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>initialize</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.oracle.pic.networking.lvv.service</groupId>
                  <artifactId>lvv-service-spec</artifactId>
                  <type>jar</type>
                  <includes>${spec-target-group}/api.yaml</includes>
                  <outputDirectory>${swagger-spec-temp-dir}</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>copy</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.oracle.pic.jipher</groupId>
                  <artifactId>jipher-jce</artifactId>
                  <!--suppress UnresolvedMavenProperty -->
                  <version>${jipher-jce-version}</version>
                  <outputDirectory>${project.build.directory}/classpath</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>bc-fips</groupId>
                  <artifactId>bc-fips</artifactId>
                  <!--suppress UnresolvedMavenProperty -->
                  <version>${bouncycastle-version}</version>
                  <outputDirectory>${project.build.directory}/classpath</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>bcpkix-fips</groupId>
                  <artifactId>bcpkix-fips</artifactId>
                  <!--suppress UnresolvedMavenProperty -->
                  <version>${bouncycastle-version}</version>
                  <outputDirectory>${project.build.directory}/classpath</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>com.oracle.pic.prism.agent</groupId>
                  <artifactId>prism-agent</artifactId>
                  <outputDirectory>${project.build.directory}/agentpath</outputDirectory>
                </artifactItem>
              </artifactItems>
              <stripVersion>true</stripVersion>
            </configuration>
          </execution>
          <execution>
            <id>analyze-dependencies</id>
            <configuration>
              <usedDependencies>
                <!-- Used at runtime for the service explorer UI. -->
                <dependency>com.oracle.pic.pegasus:pegasus-swagger-ui</dependency>
                <dependency>io.dropwizard:dropwizard-assets</dependency>

                <!-- Used at build time for maven-surefire-plugin to have a Test Engine. -->
                <dependency>org.junit.jupiter:junit-jupiter-engine</dependency>

                <!-- Used at runtime by the Prism JCE metrics library.
                     The prism-agent is a Java agent. Agents are not included in the main (shaded) jar. It will be
                     provided at runtime by passing '-javaagent:/path/to/prism-agent.jar' to the java command line -->
                <dependency>com.oracle.pic.prism.agent:prism-agent</dependency>
              </usedDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.0.0</version>
        <executions>
          <!-- Copies (does not filter) config resources from config to target/config -->
          <execution>
            <id>copy-config-resources</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/config</outputDirectory>
              <resources>
                <resource>
                  <directory>config</directory>
                  <includes>
                    <include>*.conf</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-scripts-resources</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/scripts</outputDirectory>
              <resources>
                <resource>
                  <directory>scripts</directory>
                  <includes>
                    <include>*</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-docker-resources</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/docker</outputDirectory>
              <resources>
                <resource>
                  <directory>docker</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-environment-config-resources</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>process-resources</phase>
            <configuration>
              <outputDirectory>${project.build.directory}/environment-config</outputDirectory>
              <resources>
                <resource>
                  <directory>environment-config</directory>
                  <includes>
                    <include>*.env</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.oracle.pic.commons.maven</groupId>
        <artifactId>oracle-swagger-maven-plugin</artifactId>
        <version>1.5.75</version>
        <executions>
          <execution>
            <id>generateModelsAndAbstractClasses</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <basePackage>com.oracle.pic.networking.lvv.service</basePackage>
              <language>oracle-java-jaxrs-service</language>
              <specPath>${spec-file}</specPath>
              <generateClient>false</generateClient>
              <generateAbstractResources>true</generateAbstractResources>
              <additionalProperties>
                <sortParamsByRequiredFlag>false</sortParamsByRequiredFlag>
              </additionalProperties>
            </configuration>
          </execution>
          <execution>
            <id>generateSpecs</id>
            <goals>
              <goal>generateSpecs</goal>
            </goals>
            <configuration>
              <yamlSpecInputPath>${spec-file}</yamlSpecInputPath>
              <!-- The file will be reachable at http://host:port/spec/api.json -->
              <enableJson>true</enableJson>
              <!-- The file will be reachable at http://host:port/spec/api.yaml -->
              <enableYaml>true</enableYaml>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.oracle.pic.commons.maven</groupId>
        <artifactId>oracle-typesafe-config-validator-plugin</artifactId>
        <version>2.0.16</version>
        <executions>
          <execution>
            <goals>
              <goal>validate</goal>
            </goals>
            <configuration>
              <configsSet>
                <directory>${basedir}/config</directory>
              </configsSet>
              <resolvedConfigDirectory>${project.build.directory}/resolved-config</resolvedConfigDirectory>
              <unresolvedSubstitutions>
                <unresolvedSubstitution>env.availabilityDomain</unresolvedSubstitution>
                <unresolvedSubstitution>env.region</unresolvedSubstitution>
                <unresolvedSubstitution>env.adNumber</unresolvedSubstitution>
                <unresolvedSubstitution>env.regionInternalName</unresolvedSubstitution>
                <unresolvedSubstitution>env.dbTnsName</unresolvedSubstitution>
                <unresolvedSubstitution>env.publicDomainName</unresolvedSubstitution>
                <unresolvedSubstitution>env.iaasDomainName</unresolvedSubstitution>
              </unresolvedSubstitutions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Java code coverage -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.10</version>
        <configuration>
          <outputDirectory>${project.build.directory}/jacoco-reports</outputDirectory>
          <excludes>
            <!--
              Exclusions for code coverage
              Excluding auto-generated source, main classes, configs and constants.
              For more details, please see https://www.eclemma.org/jacoco/trunk/doc/report-mojo.html#excludes
            -->
            <!-- auto-generated -->
            <exclude>com/oracle/pic/networking/lvv/service/api/**/*</exclude>
            <exclude>com/oracle/pic/networking/lvv/service/model/**/*</exclude>
            <!-- config -->
            <exclude>com/oracle/pic/networking/lvv/service/config/**/*</exclude>
            <!-- constants -->
            <exclude>com/oracle/pic/networking/lvv/service/auth/AuthVerbs.class</exclude>
            <!-- ignore main classes -->
            <exclude>com/oracle/pic/networking/lvv/service/LvvServiceApi*.class</exclude>
            <!-- did nothing, only for local testing purpose -->
            <exclude>com/oracle/pic/networking/lvv/service/auth/PassThruAuthHelper.class</exclude>
            <!-- ignore common for testing -->
            <exclude>com/oracle/pic/networking/lvv/service/common/**/*</exclude>
            <!-- ignore identity for testing -->
            <exclude>com/oracle/pic/networking/lvv/service/identity/**/*</exclude>
            <!-- ignore MockNcpClients for testing -->
            <exclude>com/oracle/pic/networking/lvv/service/dependencies/ncp/Mock*.class</exclude>
            <!-- ignore Kiev Helper class for testing -->
            <exclude>com/oracle/pic/networking/lvv/service/kiev/DataStoreProvider.class</exclude>
            <exclude>com/oracle/pic/networking/lvv/service/kiev/KievHashBucketProvider.class</exclude>
            <!-- ignore helper class for testing -->
            <exclude>com/oracle/pic/networking/lvv/service/etag/*</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>default-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>default-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule
                  implementation="org.jacoco.maven.RuleConfiguration">
                  <element>BUNDLE</element>
                  <limits>
                    <limit
                      implementation="org.jacoco.report.check.Limit">
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <!-- Tweak this as you gain coverage -->
                      <!-- Will fast followup to make this 0.8 -->
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- maven-shade-plugin:
           When instantiating a JCE provider's implementation (class) of a Cipher, KeyAgreement, KeyGenerator, MAC or
           SecretKey factory, the JCA framework determines the provider's codebase (JAR file) and verifies its signature.
           In this way, the JCA authenticates the provider and ensures that only providers signed by a trusted entity
           can be plugged into the JCA. Consequently, these classes cannot be extracted from their original JARs,
           such as the jipher-jce and bc-fips JARs, and included in an application's Uber JAR.
           Instead the original signed JARs must be available to the classloader by placing them in the classpath
           There is corresponding config in the maven-dependency-plugin, to copy the signed JARs into the classpath,
           and actions in the dockerfile to embed the signed JARs in the docker image. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <!-- We shouldn't need the Dependency Reduced Pom.  Don't change it. -->
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
                <exclude>org/bouncycastle</exclude>
                <exclude>org/bouncycastle/**/*</exclude>
              </excludes>
            </filter>
          </filters>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Main-Class>${jar.main.class}</Main-Class>
                    <Class-Path>classpath/jipher-jce.jar classpath/bc-fips.jar classpath/bcpkix-fips.jar</Class-Path>
                  </manifestEntries>
                </transformer>
              </transformers>
              <artifactSet>
                <excludes>
                  <exclude>com.oracle.pic.prism.agent:prism-agent</exclude>
