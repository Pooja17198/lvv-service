    <swagger-spec-temp-dir>${project.build.directory}</swagger-spec-temp-dir>
    <!-- By default build the release version of the spec file -->
    <spec-target-group>release</spec-target-group>
    <!--
        Swagger spec is defined in lvv-service-spec/specs/api.cond.yaml

        spec-conditionals-preprocessor-plugin generates ${spec-target-group}/api.yaml based on enabled group files.

        Having multiple enabled group files allows you to specify different enabled groups at different stages of your
        service, e.g. have experimental features enabled in a test environment, but only released features in production.

        For details refer to following pages -
        https://confluence.oci.oraclecorp.com/display/DEX/Swagger+Spec+Preprocessor
        https://confluence.oci.oraclecorp.com/display/DEX/Swagger+Spec+Branching+Strategy
    -->
    <spec-file>${swagger-spec-temp-dir}/${spec-target-group}/api.yaml</spec-file>
  </properties>

